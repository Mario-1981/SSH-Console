{
  "stopOnError": true,
  "inputs": [
    {
      "name": "service",
      "label": "Systemd-Dienst",
      "type": "text",
      "default": "nginx",
      "placeholder": "z. B. nginx, postgresql, docker",
      "required": true
    }
  ],
  "steps": [
    {
      "type": "run",
      "id": "check",
      "command": "systemctl is-active {{vars.service}}",
      "continueOnError": true,
      "filter": {
        "trim": true
      }
    },
    {
      "type": "if",
      "when": {
        "from": "check",
        "field": "stdout",
        "op": "notEquals",
        "value": "active"
      },
      "then": [
        {
          "type": "run",
          "id": "restart",
          "command": "systemctl restart {{vars.service}}"
        },
        {
          "type": "sleep",
          "seconds": 3
        },
        {
          "type": "run",
          "id": "verify",
          "command": "systemctl is-active {{vars.service}}",
          "continueOnError": true,
          "filter": {
            "trim": true
          }
        },
        {
          "type": "set",
          "name": "action",
          "value": "Neu gestartet"
        },
        {
          "type": "set",
          "name": "finalState",
          "value": "{{verify.stdout}}"
        }
      ],
      "else": [
        {
          "type": "set",
          "name": "action",
          "value": "Keine Aktion nötig"
        },
        {
          "type": "set",
          "name": "finalState",
          "value": "{{check.stdout}}"
        }
      ]
    }
  ],
  "output": {
    "format": "table",
    "headers": [
      "Eigenschaft",
      "Wert"
    ],
    "rows": [
      {
        "label": "Server",
        "value": "{{target.label}} ({{target.ip}})"
      },
      {
        "label": "Dienst",
        "value": "{{vars.service}}"
      },
      {
        "label": "Vorher",
        "value": "{{check.stdout}} (Exit {{check.exitCode}})"
      },
      {
        "label": "Aktion",
        "value": "{{vars.action}}"
      },
      {
        "label": "Aktueller Status",
        "value": "{{vars.finalState}}"
      }
    ]
  }
}
