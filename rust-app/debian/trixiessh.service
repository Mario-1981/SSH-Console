[Unit]
Description=TrixieSSH — Rust SSH Certificate Command Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trixiessh
Group=trixiessh
WorkingDirectory=/opt/trixiessh
ExecStart=/usr/local/bin/trixiessh
Environment=TRIXIESSH_BIND=0.0.0.0:3000
Environment=TRIXIESSH_DATA_DIR=/var/lib/trixiessh
Environment=TRIXIESSH_STATIC_DIR=/opt/trixiessh/dist
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=3

# Systemd Hardening (Debian Trixie)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/trixiessh
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes

[Install]
WantedBy=multi-user.target
